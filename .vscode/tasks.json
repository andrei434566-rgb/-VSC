{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentVSC: Clone or update repository",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\sync_repository.ps1",
        "-Repository",
        "${input:repository}",
        "-DestinationPath",
        "${input:destinationPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "repository",
      "type": "promptString",
      "description": "URL/SSH-адрес удалённого репозитория или путь к локальному Git-репозиторию"
    },
    {
      "id": "destinationPath",
      "type": "promptString",
      "description": "Путь для нового клона (для обновления можно оставить пустым)"
    }
  ]
}
